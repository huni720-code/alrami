# ── 백엔드 환경변수 예시 (배포 호스트의 환경변수에 입력) ──
# 필수
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME   # Neon 연결 문자열
SECRET_KEY=change-me-to-a-long-random-string          # 아무 긴 랜덤 문자열

# 배포 시 (프론트 도메인)
CORS_ORIGINS=https://YOUR-FRONT.vercel.app            # 콤마로 여러 개 가능
SERVICE_URL=https://YOUR-FRONT.vercel.app             # 알림 링크에 사용

# 카카오 로그인 (선택 — 로그인 OAuth용. 알림톡과 별개)
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=https://YOUR-FRONT.vercel.app/oauth/callback

# 이메일 발송 (선택 — 지인 테스트 알림용, 사업자 불필요)
SENDGRID_API_KEY=
FROM_EMAIL=

# 카카오 알림톡 (사업자 등록 후)
KAKAO_ALIMTALK_KEY=
KAKAO_SENDER_KEY=
